{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "child-expense-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "ai": { "binding": "AI" },
  "vars": {
    "ALLOWED_ORIGIN": "https://showatsushin.github.io"
  }
}